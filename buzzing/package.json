        "@sveltejs/kit": "^2.43.2",
        "@sveltejs/vite-plugin-svelte": "^6.2.0",
        "@types/dotenv": "^8.2.0",
        "@types/js-cookie": "^3.0.1",
        "@types/jsonwebtoken": "^8.5.8",
        "@types/node": "^22",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.12.4",
        "globals": "^16.4.0",
